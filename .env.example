# Dashboard environment contract (T10) - local development only
# Copy to .env.local and fill real values. Never commit .env.local or any real key.
# See nest-ecommerce/.env.example and DASHBOARD_NEST_ECOMMERCE_INTEGRATION_PLAN.md.

# Nest API base - must include /v1 (no trailing slash).
NEXT_PUBLIC_BACKEND_URL=http://localhost:3001/v1

# Dashboard platform key - must be one value from Nest's API_KEYS_DASHBOARD.
# Must be distinct from API_KEYS_WEB and API_KEYS_MOBILE (one key per platform, never share).
# This key is visible in the browser (NEXT_PUBLIC_) - it identifies the app, not the user.
# Real values must never be committed - keep them in untracked .env.local only.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
NEXT_PUBLIC_DASHBOARD_API_KEY=replace-with-your-dashboard-platform-api-key
